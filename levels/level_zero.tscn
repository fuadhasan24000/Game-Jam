[sub_resource type="GDScript" id="GDScript_kgsqp"]
script/source = "extends Node2D

@onready var fade_overlay: ColorRect = $CanvasLayer/FadeOverlay
var exit_entered =false
var collectibles_area = false
func _ready() -> void:
	# Make sure it's visible, solid black, and drawn on top
	$music.play()
	fade_overlay.show()
	fade_overlay.color = Color(0, 0, 0, 1.0)
	GameManager.player_health =200
	GameManager.scraps= 0
	GameManager.canvas_scraps= 0
	# Animate opacity from 1.0 (black) down to 0.0 (clear) over 1.5 seconds
	var tween = create_tween()
	tween.tween_property(fade_overlay, \"color:a\", 0.0, 1.8)
	
	# Turn it off after the animation finishes
	await tween.finished
	fade_overlay.hide()

	DialogueManager.start_dialogue(DialogueManager.dialogues_t1[0])
	

func _on_exit_btn_pressed() -> void:
	fade_overlay.show()
	fade_overlay.color.a = 0.0
	var tween = create_tween()
	tween.tween_property(fade_overlay, \"color:a\", 1.0, 1.0)
	await tween.finished
	get_tree().change_scene_to_file(\"res://levels/menu.tscn\") # Replace with function body.

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"enter\") and exit_entered:
		GameManager.scrap1 = GameManager.canvas_scraps
		GameManager.ascrap1 = GameManager.scraps
		get_tree().change_scene_to_file(\"res://levels/level_1.tscn\")


func _on_level_2_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		exit_entered =true

func _on_level_2_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		exit_entered =false


func _on_d_1_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		DialogueManager.start_dialogue(DialogueManager.dialogues_t1[1])
		$D1.queue_free()
"

